---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

import mdfImage from '~/assets/images/mdf.jpeg';
import cargoImage from '~/assets/images/cargo-ship.jpeg';
import forkliftImage from '~/assets/images/forklift.jpeg';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Services"
    title="MDF Door Solutions for Every Scale"
    subtitle="From custom manufacturing to international bulk distribution, BELLO delivers exceptional MDF door solutions with precision and care."
    actions={[{ variant: 'primary', text: 'Contact Now', href: '/contact' }]}
    image={{
      src: mdfImage,
      alt: 'BELLO MDF Factory',
    }}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="What We Offer"
    subtitle="From manufacturing to shipping logistics — we've got it all covered."
    columns={3}
    items={[
      {
        title: 'Custom Manufacturing',
        description: 'Tailored MDF doors to your exact specifications — quality, finish, size, and more.',
        icon: 'tabler:tools',
      },
      {
        title: 'Bulk Fulfillment',
        description: 'Seamless processing for large-scale construction orders, saving you time and cost.',
        icon: 'tabler:package-export',
      },
      {
        title: 'Reliable Shipping',
        description: 'Worldwide logistics with factory-direct delivery from Georgia and Uzbekistan.',
        icon: 'tabler:ship',
      }
    ]}
  />

  <!-- Content Widget **************** -->
  <Content
    isReversed
    items={[
      {
        title: 'Global Reach',
        description: 'We serve clients across Europe, Asia, and North America with efficient logistics.',
        icon: 'tabler:world',
      },
      {
        title: 'Trusted By Builders',
        description: 'Our doors are found in top-tier residential and commercial developments.',
        icon: 'tabler:building',
      },
      {
        title: '16+ Years of Experience',
        description: 'Two factories and a decade-long legacy of MDF manufacturing excellence.',
        icon: 'tabler:certificate',
      },
    ]}
    image={{
      src: cargoImage,
      alt: 'Cargo ship with BELLO doors',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Why Choose BELLO</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Ready Infrastructure',
        description: 'Forklift-ready warehouses and organized inventory for smooth order prep.',
        icon: 'tabler:building-warehouse',
      },
      {
        title: 'Factory-Direct Communication',
        description: 'We eliminate middlemen — work directly with the source.',
        icon: 'tabler:phone-call',
      },
    ]}
    image={{
      src: forkliftImage,
      alt: 'Forklift in BELLO warehouse',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Operations That Deliver</h3>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[{
      variant: 'primary',
      text: 'Contact Now',
      href: '/contact',
    }]}
    title="Ready to Partner with BELLO?"
    subtitle="Connect with us to discuss bulk orders, custom manufacturing, or becoming a distribution partner. We're here to help bring your project to life."
  />
</Layout>