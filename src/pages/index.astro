---
import mdfImage from '~/assets/images/mdf.png';

import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AstroWind — Free template for creating websites with Astro + Tailwind CSS',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

   <!-- BELLO -->
<Hero
  actions={[
    {
      variant: 'primary',
      text: 'Contact Us',
      href: '/contact', // ✅ fixed
      icon: 'tabler:send',
    },
    {
      text: 'View Capabilities',
      href: '#features',
    },
  ]}
  alt="BELLO MDF Door in Interior"
>
  <Fragment slot="title">
    Industry-Leading <span class="text-primary dark:text-white highlight">MDF Door Manufacturer</span>
  </Fragment>

  <Fragment slot="subtitle">
    Over 16 years of experience, trusted by top builders across Georgia, Uzbekistan, and global markets.
  </Fragment>
</Hero>

   <!-- BELLO -->


  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

<Features
  id="features"
  tagline="Capabilities"
  title="Why Construction Partners Choose BELLO"
  subtitle="Precision-built doors, customizable features, and dependable global delivery trusted by builders and distributors."
  items={[
    {
      title: 'Custom Engineering',
      description: 'Doors tailored to your exact specifications — size, core, hardware, finish, and function.',
      icon: 'tabler:tool',
    },
    {
      title: 'Reliable Lead Times',
      description: 'Production and delivery timelines built to meet construction schedules at scale.',
      icon: 'tabler:calendar-time',
    },
    {
      title: 'Premium-Grade MDF',
      description: 'Moisture-resistant, warp-free, and sustainably sourced core materials.',
      icon: 'tabler:layers-intersect',
    },
    {
      title: 'Global Logistics',
      description: 'Factories in Georgia and Uzbekistan. Delivery to 10+ countries with export-ready packaging.',
      icon: 'tabler:world',
    },
    {
      title: 'Architectural Aesthetics',
      description: 'Modern styles that elevate any residential or commercial space.',
      icon: 'tabler:building-arch',
    },
    {
      title: 'Dedicated Support',
      description: 'Partnership-focused communication from inquiry to post-installation.',
      icon: 'tabler:message-chatbot',
    },
  ]}
/>

  <!-- Content Widget **************** -->

<Content
  isReversed
  tagline="Our Foundation"
  title="Precision Craftsmanship Backed by Scale"
  items={[
    {
      title: 'State-of-the-Art Manufacturing',
      description:
        'Two production facilities in Georgia and Uzbekistan with high-capacity automated lines and strict quality control.',
    },
    {
      title: 'Durable & Sustainable Materials',
      description:
        'Moisture-resistant MDF and eco-certified woods ensure long-term performance and environmental responsibility.',
    },
    {
      title: 'Built for Architects & Developers',
      description:
        'Every product is made to meet the demands of modern construction, from fire-rated doors to architectural styles.',
    },
  ]}
>
 <Fragment slot="image">
  <div class="w-full max-w-3xl mx-auto px-4">
    <img
      src="/images/hero-bello.jpg"
      alt="BELLO Factory Overview"
      class="rounded-xl shadow-lg w-full h-auto object-cover"
      loading="eager"
    />
  </div>
</Fragment>


  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
      Built to Perform. Designed to Impress.
    </h3>
    Every BELLO door is the result of engineering excellence, timeless design, and industry-tested materials.
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-gray-50 dark:bg-transparent"></div>
  </Fragment>
</Content>



  <!-- Content Widget **************** -->

 <Content
  isAfterContent
  items={[
    {
      title: 'Architect-Grade Aesthetics',
      description: 'Designed with modern architecture in mind — our doors elevate residential and commercial interiors alike.',
    },
    {
      title: 'Regional Customization',
      description: 'Choose from fire-rated options, size variations, materials, and finishes based on local code and climate.',
    },
    {
      title: 'Seamless B2B Fulfillment',
      description: 'Our factory-direct model supports fast lead times, custom packaging, and secure international delivery.',
    },
    {
      title: 'Versatile Applications',
      description: 'From luxury condos to office buildings — our MDF door collection adapts to your project requirements.',
    },
  ]}
>
  <Fragment slot="image">
    <div class="flex justify-center items-center py-10">
      <img
        src="/images/customize-door.jpg"
        alt="Customizable MDF Door"
        width="1200"
        height="800"
        class="rounded-xl shadow-lg w-full max-w-4xl h-auto"
        loading="eager"
      />
    </div>
  </Fragment>

  <Fragment slot="content">
    Solutions crafted to meet industry standards, with flexibility to serve every market.
  </Fragment>
</Content>


  <!-- Content Widget **************** -->

 <Content
  isReversed
  isAfterContent
  items={[
    {
      title: 'Premium MDF Door Manufacturing',
      description:
        'With over 16 years of experience, BELLO delivers unmatched quality and craftsmanship in every door we produce.',
    },
    {
      title: 'Tailored to Your Vision',
      description:
        'From style to specifications, our doors are fully customizable to meet the demands of residential, commercial, and luxury projects.',
    },
    {
      title: 'Reliable Global Supply',
      description:
        'With manufacturing hubs in Georgia and Uzbekistan, we ensure fast, consistent delivery to distributors and construction partners worldwide.',
    },
    {
      title: 'Trusted by Top Builders',
      description:
        'We are the #1 MDF door supplier in our regions — a reputation built on trust, performance, and long-term partnerships.',
    },
  ]}
  image={{
    src: '~/assets/images/blog-4.JPG',
    alt: 'Modern white interior MDF door by BELLO',
  }}
>
  <Fragment slot="content">
    Built for Builders. Trusted Worldwide.
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Content>

  <!-- Steps Widget ****************** -->

<Steps
  title="From Concept to Completion – Our 4-Step Door Manufacturing Process"
  items={[
    {
      title: '<span class="font-medium">Step 1: Inquiry & Planning</span>',
      description: 'You send us your specifications and goals. Our team reviews everything and outlines the best approach.',
      icon: 'tabler:message',
    },
    {
      title: '<span class="font-medium">Step 2: Design & Customization</span>',
      description: 'We create detailed drafts, finalize dimensions, materials, finishes, and ensure compliance with project needs.',
      icon: 'tabler:brush',
    },
    {
      title: '<span class="font-medium">Step 3: Manufacturing & Quality Control</span>',
      description: 'Production begins at our facilities using advanced CNC machines and strict QA processes for consistency.',
      icon: 'tabler:settings',
    },
    {
      title: '<span class="font-medium">Ready for Shipment</span>',
      description: 'Your doors are securely packaged and prepped for pickup or international delivery — ready when you are.',
      icon: 'tabler:check',
    },
  ]}
  image={{
    src: mdfImage,
    alt: 'MDF Door Production at BELLO',
  }}
/>





  <!-- Features2 Widget ************** -->

  <Features2
  title="What Makes BELLO Stand Out"
  subtitle="Our capabilities are designed to serve construction firms, architects, and distributors with precision and scale."
  tagline="Capabilities"
  items={[
    {
      title: 'Interior & Exterior Door Lines',
      description: 'Extensive variety of flush, panel, and bi-fold designs for residential and commercial projects.',
      icon: 'tabler:door',
    },
    {
      title: 'Custom Orders & Fire-Rated Options',
      description: 'Tailored solutions including fire-rated doors certified for up to 90 minutes and custom hardware.',
      icon: 'tabler:settings-cog',
    },
    {
      title: 'In-House Manufacturing',
      description: 'Two cutting-edge facilities in Georgia and Uzbekistan producing over 500,000 doors annually.',
      icon: 'tabler:building-factory',
    },
    {
      title: 'Logistics & Global Shipping',
      description: 'Reliable distribution with export packaging and fast turnaround for large-scale contracts.',
      icon: 'tabler:truck-delivery',
    },
    {
      title: 'Bulk Discounts for B2B Partners',
      description: 'Volume-based pricing and flexible MOQ programs for construction companies and retailers.',
      icon: 'tabler:discount-2',
    },
    {
      title: 'Material Innovation',
      description: 'Premium MDF cores, moisture-resistant coatings, and durable finishes designed for long-term use.',
      icon: 'tabler:layers-intersect',
    },
    {
      title: 'Design Consultation',
      description: 'Our in-house experts collaborate with your architects to ensure each door fits your vision.',
      icon: 'tabler:palette',
    },
    {
      title: 'Multi-Market Experience',
      description: 'From luxury condos to student housing — we’ve supplied projects in 10+ countries.',
      icon: 'tabler:world',
    },
    {
      title: 'Dedicated Support Team',
      description: 'We’re your long-term partner — from quoting and sample review to post-installation follow-ups.',
      icon: 'tabler:users-group',
    },
  ]}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Features2>


  <!-- HighlightedPosts Widget ******* -->

 
  <!-- FAQs Widget ******************* -->

  <FAQs id="faq"
  title="Frequently Asked Questions"
  subtitle="Here are some common questions about our MDF doors, factory capabilities, and partnership opportunities."
  tagline="FAQs"
  classes={{ container: 'max-w-6xl' }}
  items={[
    {
      title: 'Where are your factories located?',
      description:
        'Our MDF door manufacturing facilities are located in Georgia and Uzbekistan. Both are equipped with state-of-the-art technology and high production capacity for global distribution.',
    },
    {
      title: 'Do you offer custom door designs?',
      description:
        'Yes, we can manufacture MDF doors in custom sizes, colors, and finishes tailored to your project requirements. Reach out to our team to begin the design process.',
    },
    {
      title: 'What is your production capacity?',
      description:
        'We handle large-scale orders with fast turnaround. Our factories operate at international standards, supplying construction companies and distributors efficiently.',
    },
    {
      title: 'Do you ship internationally?',
      description:
        'Yes, we export doors globally. We provide full logistics support and can assist with customs processes in various countries including the U.S., Europe, and Asia.',
    },
    {
      title: 'What materials do you use?',
      description:
        'We use high-quality MDF and eco-friendly coatings. Our products meet international durability and safety standards.',
    },
    {
      title: 'How can I become a distributor?',
      description:
        'You can fill out our contact form on the website or reach us directly via email or WhatsApp. We’ll guide you through pricing, samples, and partnership setup.',
    },
  ]}
/>


  <!-- Stats Widget ****************** -->

<Stats
  stats={[
    { title: 'Years of Experience', amount: '16+' },
    { title: 'Factories Worldwide', amount: '2' },
    { title: 'Doors Delivered', amount: '500K+' },
    { title: 'Global Clients', amount: '300+' },
  ]}
/>

  <!-- CallToAction Widget *********** -->

<CallToAction
actions={[
  {
    variant: 'primary',
    text: 'Contact Now',
    href: '/contact',
    target: '_self',
    icon: 'tabler:mail',
  },
]}

>
  <Fragment slot="title">
    Ready to Partner with <span class="sm:whitespace-nowrap">BELLO?</span>
  </Fragment>

  <Fragment slot="subtitle">
    Connect with us to discuss bulk orders, custom manufacturing, or becoming a distribution partner. <br class="hidden md:inline" />We’re here to help bring your project to life.
  </Fragment>
</CallToAction>
</Layout>

