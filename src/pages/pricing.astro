---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Custom Orders – BELLO',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Custom Orders"
    title="Tailored MDF Doors for Your Project"
    subtitle="Choose a custom solution that fits your unique vision and requirements."
  />

  <!-- Custom Quote Widget ******************* -->

  <Prices
    title="Get a Custom Quote"
    subtitle="We create MDF doors built to your exact specifications."
    prices={[
      {
        title: 'Custom',
        subtitle: 'Made-to-order solutions for contractors, distributors & builders',
        price: 'Contact',
        period: 'for quote',
        items: [
          {
            description: 'Custom dimensions & finishes',
          },
          {
            description: 'Fire-rated or acoustic configurations',
          },
          {
            description: 'Flexible minimum order quantities',
          },
          {
            description: 'Fast lead times & global shipping',
          },
        ],
        callToAction: {
          target: '_self',
          text: 'Get a Quote',
          href: '/contact',
        },
        hasRibbon: true,
        ribbonTitle: 'Recommended',
      },
    ]}
  />

  <!-- Image Section (Optional Visual Highlight) *********** -->

  <section class="py-12">
    <div class="max-w-4xl mx-auto">
      <img
        src="/images/blog-1.JPG"
        alt="Custom BELLO MDF Door"
        width="1748"
        height="2047"
        style="width: 100%; border-radius: 12px;"
      />
    </div>
  </section>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Start Your Custom Order Today"
    subtitle="Let us help you deliver top-tier MDF doors for your next project."
    actions={[
      {
        variant: 'primary',
        text: 'Contact Our Team',
        href: '/contact',
      },
    ]}
  />
</Layout>
