---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>



  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Manufacturing Excellence in Every Detail<br />
      <span class="text-primary dark:text-white highlight"> Discover the Story of BELLO</span>
    </Fragment>

    <Fragment slot="subtitle">
      For over 16 years, BELLO has led the MDF door industry with dedication to design, durability, and trust. With
      manufacturing facilities in Georgia and Uzbekistan, we supply construction professionals across the globe with
      premium, customizable doors that meet the highest standards.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our Impact"
    stats={[
      { title: 'Factories', amount: '2' },
      { title: 'Years in Business', amount: '16' },
      { title: 'Countries Served', amount: '12' },
      { title: 'Projects Completed', amount: '5K+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What We Offer"
    subtitle="We provide high-performance MDF doors that combine elegance with functionality — engineered to enhance homes, commercial buildings, and industrial projects alike."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Custom Designs',
        description:
          'We work closely with distributors and developers to craft doors tailored to exact specifications and aesthetics.',
        icon: 'tabler:template',
      },
      {
        title: 'Durability & Quality',
        description:
          'Our MDF doors undergo strict quality control, ensuring strength, resistance, and long-term performance.',
        icon: 'tabler:template',
      },
      {
        title: 'Efficient Logistics',
        description:
          'With facilities in Georgia and Uzbekistan, we ensure fast delivery and steady supply chains across markets.',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Interior Doors',
        description:
          'Stylish and functional interior solutions crafted with precision and modern design sensibilities.',
        icon: 'tabler:template',
      },
      {
        title: 'Commercial Projects',
        description:
          'BELLO doors are used in hotels, offices, and multi-unit developments across Central Asia and Europe.',
        icon: 'tabler:template',
      },
      {
        title: 'Bulk Manufacturing',
        description:
          'We scale with your business. From small batches to large-scale production, we deliver on time and to spec.',
        icon: 'tabler:template',
      },
      {
        title: 'Partnerships',
        description:
          'We collaborate with architects, designers, and builders to provide products that elevate the built environment.',
        icon: 'tabler:template',
      },
      {
        title: 'Sustainable Practices',
        description:
          'Our production process prioritizes low waste and eco-conscious sourcing — without sacrificing quality.',
        icon: 'tabler:template',
      },
      {
        title: 'Finishing Options',
        description:
          'We offer a wide range of colors, textures, and coatings to match your project’s design goals.',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our Values"
    subtitle="Every BELLO product is rooted in craftsmanship, innovation, and integrity — values that shape the way we do business every day."
    items={[
      {
        title: 'Client-First Focus',
        description:
          'We listen, adapt, and deliver according to each client’s unique needs and goals.',
      },
      {
        title: 'Innovation & Adaptability',
        description:
          'As market demands shift, we continually refine our offerings and processes.',
      },
      {
        title: 'Responsibility',
        description:
          'We operate with honesty and a long-term mindset, prioritizing sustainability and community impact.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Let’s Work Together"
    subtitle="Have a project in mind or want to partner with BELLO? Let’s discuss how we can support your business with high-quality, customized MDF door solutions."
    isReversed={true}
    callToAction={{
      text: 'Contact Us',
      href: '/contact',
    }}
    items={[
      {
        title: 'Worldwide Distribution',
        description:
          'Our doors are delivered to leading construction projects across Europe, Asia, and North America.',
        icon: 'tabler:globe',
      },
      {
        title: 'Reliable Service',
        description:
          'We’re known for timely delivery, transparent communication, and long-term client relationships.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Expert Guidance',
        description:
          'Our experienced team is ready to assist with specifications, custom solutions, and logistics planning.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our Locations"
    tagline="Find us"
    columns={4}
    items={[
      {
        title: 'Georgia (HQ)',
        description: 'Tbilisi, Georgia — Main production & logistics hub.',
      },
      {
        title: 'Uzbekistan',
        description: 'Tashkent, Uzbekistan — Large-scale manufacturing facility.',
      },
      {
        title: 'United States',
        description: 'Regional sales and distributor inquiries.',
      },
      {
        title: 'Europe',
        description: 'Partners and resellers across key European cities.',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Support Channels"
    tagline="Contact us"
    columns={2}
    items={[
      {
        title: 'Chat with Our Team',
        description:
          'For questions about orders, timelines, or technical specs — we’re ready to assist.',
        icon: 'tabler:messages',
      },
      {
        title: 'Phone Support',
        description:
          'Reach us directly during business hours for quick answers and personalized support.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
